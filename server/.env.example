# Server Port (auto-assigned by Render in production, or 5000 in dev)
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=production

# MongoDB Connection String (Atlas M0 Cluster URI for production, or local MongoDB for dev)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_rent_connect?retryWrites=true&w=majority

# JWT Signing Secret (generate a strong random secret in production)
JWT_SECRET=replace_with_a_long_random_secret_string_for_production_jwt_signing

# Allowed Frontend Origins (Comma-separated URLs for CORS)
CORS_ORIGIN=https://smart-rent-connect.vercel.app,http://localhost:3000
CLIENT_URL=https://smart-rent-connect.vercel.app
