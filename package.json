{
  "name": "smart-rent-connect",
  "version": "1.0.0",
  "description": "Smart Rent Connect - A Location-Based Rental House Finder",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run --prefix server dev",
    "dev:client": "npm run --prefix client dev",
    "build:server": "npm run --prefix server build",
    "build:client": "npm run --prefix client build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm run --prefix server start",
    "test": "npm run --prefix server test"
  },
  "keywords": [
    "rental",
    "location-based",
    "nextjs",
    "express",
    "mongodb",
    "geojson"
  ],
  "author": "",
  "license": "ISC"
}
